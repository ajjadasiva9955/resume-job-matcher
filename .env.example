# ==============================================================================
# SkillBridge.AI — Production Environment Configuration Template (.env.example)
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to .env:  cp .env.example .env
# 2. Fill in the values for your environment.
# 3. NEVER commit the .env file containing real secrets to GitHub!
# ==============================================================================

# Flask Secret Key (Required: Used for session signing, CSRF tokens, and API key encryption)
# Generate a secure 64-char random key using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Session Cookie Security (Set to True for HTTPS production deployment on Render, False for local dev)
SESSION_COOKIE_SECURE=

# Google Gemini API Key (Optional fallback key if not provided per-user in Profile)
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# SerpAPI Key (Optional fallback key for Google Jobs and Market Demand if not provided in Profile)
# Obtain from: https://serpapi.com/
SERPAPI_KEY=

# Default Gemini AI Model (Optional, defaults to gemini-2.5-flash)
GEMINI_MODEL=

# Database Path (Optional, defaults to instance/skillbridge.db)
DATABASE_PATH=

# Gmail SMTP Email Configuration (Used for password reset emails)
# For Gmail, generate a 16-character App Password at: https://myaccount.google.com/apppasswords
MAIL_SERVER=
MAIL_PORT=
MAIL_USE_TLS=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
